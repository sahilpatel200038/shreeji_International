# Production environment template for the Shreeji International Courier
# backend. Copy this to .env on the production server and fill in every
# blank marked below. Never commit the real .env with actual values.

APP_NAME="Shreeji Tracking"
APP_ENV=production
# Generate on the server after copying this file: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://backend.shreejiinternationalcourier.com

# Comma-separated list of origins allowed to call this API (CORS). Both the
# apex and www forms of the production site are declared as canonical in
# apps/frontend (robots.txt / sitemap.xml) — update if that ever changes.
FRONTEND_URL=https://www.shreejiinternationalcourier.com,https://shreejiinternationalcourier.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (fill in with the production database credentials) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@shreejiinternationalcourier.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed if S3-based storage is actually used (FILESYSTEM_DISK=s3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Tracking carrier APIs — fill in real production credentials for each ---
ACX_API_BASE_URL=https://admin.acxintl.in
ACX_API_COMPANY_ID=
ACX_CUSTOMER_CODE=

PATEL_API_BASE_URL=https://admin.patelcouriers.in
PATEL_API_COMPANY_ID=
PATEL_CUSTOMER_CODE=

SSCF_API_BASE_URL=https://admin.sscf.online
SSCF_API_COMPANY_ID=
SSCF_CUSTOMER_CODE=

HISPEED_API_BASE_URL=https://admin.hispeedinternationalcourier.com
HISPEED_API_COMPANY_ID=
HISPEED_CUSTOMER_CODE=

# How long a synced shipment is trusted before re-querying its carrier, and
# how long a single carrier request is allowed to take before the
# ACX -> Patel -> SSCF -> HiSpeed fallback chain moves to the next provider.
TRACKING_CACHE_TTL_MINUTES=15
TRACKING_CONNECT_TIMEOUT_SECONDS=5
TRACKING_REQUEST_TIMEOUT_SECONDS=8

# Sanctum stateful domains (only relevant if cookie-based SPA auth is ever
# used; the admin panel currently authenticates with Bearer tokens, so this
# is a formality rather than a hard requirement).
SANCTUM_STATEFUL_DOMAINS=backend.shreejiinternationalcourier.com,www.shreejiinternationalcourier.com,shreejiinternationalcourier.com
