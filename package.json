{
  "name": "shreeji-international",
  "version": "1.0.0",
  "private": true,
  "description": "Shreeji International Courier - monorepo (React/Vite frontend + Laravel tracking API)",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,magenta \"npm run dev --workspace=apps/frontend\" \"npm run backend:serve\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run backend:serve",
    "build": "npm run build --workspace=apps/frontend",
    "lint": "npm run lint --workspace=apps/frontend",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run lint --workspace=apps/frontend",
    "test:backend": "cd apps/backend && php artisan test",
    "backend:serve": "cd apps/backend && php artisan serve --port=8010",
    "backend:install": "cd apps/backend && composer install",
    "backend:migrate": "cd apps/backend && php artisan migrate",
    "backend:migrate:fresh": "cd apps/backend && php artisan migrate:fresh --seed",
    "backend:seed": "cd apps/backend && php artisan db:seed",
    "setup": "npm install && npm run backend:install && npm run backend:migrate:fresh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahilpatel200038/shreeji_International.git"
  },
  "license": "ISC"
}
